rules_version = '2';

// Default-deny. Each student can only reach documents under their own uid, and
// every write is validated for shape and size. Collections are listed
// explicitly (no recursive wildcard), because allow rules are OR-ed and a
// wildcard would bypass per-collection validation.
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function isText(value, max) {
      return value is string && value.size() > 0 && value.size() <= max;
    }

    function stampedNow(data) {
      return data.updatedAt == request.time;
    }

    function createdNow(data) {
      return data.createdAt == request.time;
    }

    function createdUnchanged() {
      return request.resource.data.createdAt == resource.data.createdAt;
    }

    match /users/{uid} {
      function validSettings(s) {
        return s is map
          && s.keys().hasOnly(['theme', 'textSize', 'locale', 'toolbarSide', 'weeklyGoalHours'])
          && (!('theme' in s) || s.theme in ['light', 'dark', 'paper'])
          && (!('textSize' in s) || s.textSize in ['sm', 'md', 'lg'])
          && (!('locale' in s) || s.locale in ['en'])
          && (!('toolbarSide' in s) || s.toolbarSide in ['left', 'right'])
          && (!('weeklyGoalHours' in s) || (s.weeklyGoalHours is int && s.weeklyGoalHours >= 1 && s.weeklyGoalHours <= 80));
      }

      function validProfile(d) {
        return d.keys().hasOnly(['settings', 'updatedAt'])
          && (!('settings' in d) || validSettings(d.settings))
          && stampedNow(d);
      }

      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid) && validProfile(request.resource.data);

      match /subjects/{subjectId} {
        function validSubject(d) {
          return d.keys().hasOnly(['name', 'color', 'createdAt', 'updatedAt'])
            && d.keys().hasAll(['name', 'color', 'createdAt', 'updatedAt'])
            && isText(d.name, 40)
            && d.color in ['blue', 'purple', 'teal', 'orange', 'green', 'rose']
            && stampedNow(d);
        }

        allow read, delete: if isOwner(uid);
        allow create: if isOwner(uid) && validSubject(request.resource.data) && createdNow(request.resource.data);
        allow update: if isOwner(uid) && validSubject(request.resource.data) && createdUnchanged();
      }

      match /notebooks/{notebookId} {
        function validNotebook(d) {
          return d.keys().hasOnly(['title', 'subjectId', 'mode', 'paper', 'background', 'pageCount', 'createdAt', 'updatedAt'])
            && d.keys().hasAll(['title', 'subjectId', 'mode', 'paper', 'background', 'pageCount', 'createdAt', 'updatedAt'])
            && isText(d.title, 120)
            && (d.subjectId == null || (d.subjectId is string && d.subjectId.size() <= 64))
            && d.mode in ['paged', 'infinite']
            && d.paper in ['dots', 'grid', 'lines', 'blank']
            && d.background in ['white', 'cream', 'sky', 'mint', 'slate']
            && d.pageCount is int && d.pageCount >= 1 && d.pageCount <= 500
            && stampedNow(d);
        }

        allow read, delete: if isOwner(uid);
        allow create: if isOwner(uid) && validNotebook(request.resource.data) && createdNow(request.resource.data);
        allow update: if isOwner(uid) && validNotebook(request.resource.data) && createdUnchanged();

        match /pages/{pageId} {
          function validPage(d) {
            return d.keys().hasOnly(['index', 'elements', 'updatedAt'])
              && d.keys().hasAll(['index', 'elements', 'updatedAt'])
              && d.index is int && d.index >= 0 && d.index < 500
              && d.elements is list && d.elements.size() <= 5000
              && stampedNow(d);
          }

          allow read, delete: if isOwner(uid);
          allow create, update: if isOwner(uid) && pageId.matches('^[A-Za-z0-9_-]{1,40}$') && validPage(request.resource.data);
        }

        // One typed note per notebook (Tiptap JSON, cleaned by the app on load and save).
        match /notes/{noteId} {
          allow read, delete: if isOwner(uid);
          allow create, update: if isOwner(uid)
            && noteId == 'main'
            && request.resource.data.keys().hasOnly(['content', 'updatedAt'])
            && request.resource.data.content is map
            && stampedNow(request.resource.data);
        }
      }

      match /activity/{day} {
        function validDay(d) {
          return d.keys().hasOnly(['seconds', 'updatedAt'])
            && d.seconds is int && d.seconds <= 86400
            && stampedNow(d);
        }

        allow read: if isOwner(uid);
        allow create: if isOwner(uid) && day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') && validDay(request.resource.data)
          && request.resource.data.seconds >= 1 && request.resource.data.seconds <= 120;
        allow update: if isOwner(uid) && validDay(request.resource.data)
          && request.resource.data.seconds - resource.data.seconds >= 1
          && request.resource.data.seconds - resource.data.seconds <= 120;
      }

      // Written by the flashcards module; readable now for the dashboard due count.
      match /cards/{cardId} {
        allow read: if isOwner(uid);
      }

      match /decks/{deckId} {
        allow read: if isOwner(uid);
      }

      match /books/{bookId} {
        function validBook(d) {
          return d.keys().hasOnly(['title', 'author', 'format', 'size', 'storagePath', 'pageCount', 'progress', 'position',
              'notebookId', 'createdAt', 'openedAt', 'updatedAt'])
            && d.keys().hasAll(['title', 'format', 'size', 'storagePath', 'pageCount', 'progress', 'position', 'createdAt', 'updatedAt'])
            && isText(d.title, 200)
            && (!('author' in d) || d.author == null || (d.author is string && d.author.size() <= 200))
            && d.format in ['pdf', 'epub', 'txt']
            && d.size is int && d.size >= 0 && d.size <= 25 * 1024 * 1024
            // The file must live in this user's own books folder.
            && d.storagePath is string && d.storagePath.matches('^users/' + uid + '/books/[0-9a-f]{32}[.](pdf|epub|txt)$')
            && d.pageCount is int && d.pageCount >= 0 && d.pageCount <= 100000
            && d.progress is number && d.progress >= 0 && d.progress <= 1
            && d.position is map && d.position.keys().hasOnly(['page', 'chapter', 'fraction'])
            && (!('notebookId' in d) || d.notebookId == null || (d.notebookId is string && d.notebookId.size() <= 64))
            && stampedNow(d);
        }

        allow read, delete: if isOwner(uid);
        allow create: if isOwner(uid) && validBook(request.resource.data) && createdNow(request.resource.data);
        allow update: if isOwner(uid) && validBook(request.resource.data) && createdUnchanged()
          && request.resource.data.storagePath == resource.data.storagePath
          && request.resource.data.format == resource.data.format;

        match /highlights/{highlightId} {
          allow read, delete: if isOwner(uid);
          allow create: if isOwner(uid)
            && request.resource.data.keys().hasOnly(['section', 'exact', 'prefix', 'suffix', 'createdAt'])
            && request.resource.data.section is int && request.resource.data.section >= 0
            && isText(request.resource.data.exact, 2000)
            && request.resource.data.prefix is string && request.resource.data.prefix.size() <= 64
            && request.resource.data.suffix is string && request.resource.data.suffix.size() <= 64
            && createdNow(request.resource.data);
        }
      }
    }
  }
}
