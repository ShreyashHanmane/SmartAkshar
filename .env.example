# Copy to .env.local (gitignored). Every setting is optional.
# AKSHAR runs entirely on this computer; nothing here is sent to the browser.

# Where the database and uploaded files are stored (default: ./data).
# AKSHAR_DATA_DIR=./data

# Port for `npm start` / `npm run serve` (always bound to 127.0.0.1).
# PORT=5174

# Optional AI features (Module 8). Only the local server reads this key; it is
# never sent to the browser. Leave unset to keep AI turned off.
# GEMINI_API_KEY=
# Optional model override (default: gemini-2.5-flash).
# GEMINI_MODEL=
