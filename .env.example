# Copy to .env.local (gitignored) and fill in your Firebase project config.
# These VITE_ values are public client identifiers used by the frontend to connect
# to Firebase Cloud Authentication.
VITE_FIREBASE_API_KEY=your-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_APP_ID=your-app-id

# Optional: Set to "true" to force using local emulators instead of real Cloud Firebase.
# VITE_USE_EMULATORS=false

# Optional server-side AI key for local features
# GEMINI_API_KEY=

