# Copy to .env.local (gitignored) and fill in your Firebase web app config.
# These VITE_ values are public client identifiers, NOT secrets.
# Never put a secret (AI provider key, service account) in a VITE_ variable.
VITE_FIREBASE_API_KEY=your-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_APP_ID=your-app-id
# Set to "true" in development to use the local emulators (project id demo-akshar).
VITE_USE_EMULATORS=true
